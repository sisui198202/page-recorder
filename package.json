{
  "name": "page-recorder",
  "version": "1.8.0",
  "description": "PageRecorder: ページのHTML・スクリーンショット取得、定時差分検知、設定管理を行うChrome拡張機能",
  "scripts": {
    "check:plan-todo": "node scripts/check-plan-todo.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "chrome-extension",
    "web-monitoring",
    "screenshot",
    "page-source",
    "automation"
  ],
  "author": "PageRecorder Team",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jest-chrome": "^0.8.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
